# MongoDB Configuration
# MongoDB Atlas connection string for Eurobridge Language Institute
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=EurobridgeLanguageInstitute

# Database name
MONGODB_DB_NAME=eurobridge

# Server Configuration
PORT=5000

# CORS Configuration
# For local development: http://localhost:5173
# For Netlify production: your-frontend-domain.netlify.app
CORS_ORIGIN=http://localhost:5173

# Environment
NODE_ENV=development
